---
import { Image } from 'astro:assets';
import { site, hours } from '../data/site';
import { u } from '../data/url';
import { imageOf } from '../data/menu';
import { HERO_WIDTHS, HERO_SIZES } from '../data/hero';
const photo = imageOf('pulled-prok')!;
// Punti da cui cola la salsa, in coordinate della foto (viewBox 300x300). Il movimento si ripete due volte, poi si ferma.
const drips = [
  { cls: 'd1', x: 96, y: 243 },
  { cls: 'd2', x: 138, y: 245 },
  { cls: 'd3', x: 180, y: 244 },
  { cls: 'd4', x: 214, y: 241 },
];
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-pin">
    <div class="hero-grid" aria-hidden="true"></div>
    <canvas class="hero-gl" aria-hidden="true" data-gl></canvas>
    <div class="hero-photo">
      <Image src={photo} alt="Pulled Pork Grill Burger: pane al sesamo, maiale sfilacciato, formaggio fuso, carne e insalata viola, su fondo nero" widths={HERO_WIDTHS} sizes={HERO_SIZES} quality={58} loading="eager" fetchpriority="high" decoding="async" />
      <svg viewBox="0 0 300 300" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="juice" cx="40%" cy="35%" r="75%">
            <stop offset="0" stop-color="#8a8a8a" /><stop offset=".55" stop-color="#4a3a2c" /><stop offset="1" stop-color="#1f1710" />
          </radialGradient>
        </defs>
        {drips.map((d) => (
          <>
            <rect class={`neck ${d.cls}`} x={d.x - 1.1} y={d.y - 1} width="2.2" height="9" rx="1.1" fill="#3a2d22" />
            <g transform={`translate(${d.x} ${d.y + 6})`}><g class={`drip ${d.cls}`}>
              <path d="M0,-5.5C2,-1.6 3.3,.8 3.3,2.3A3.3,3.3 0 0 1 -3.3,2.3C-3.3,.8 -2,-1.6 0,-5.5Z" fill="url(#juice)" />
            </g></g>
          </>
        ))}
      </svg>
    </div>
    <p class="hero-facts"><span>Roseto degli Abruzzi (TE)</span><span>Sera · {hours.opens}–{hours.closes}</span></p>
    <div class="hero-copy">
      <h1 id="hero-title"><span><b>Hamburger</b></span><span><b>e carni alla griglia</b></span></h1>
      <p class="lead">Braceria e hamburgeria con ispirazione sudamericana, in {site.street}.</p>
      <div class="btn-row">
        <a class="btn primary" href={u('/menu/')}>Ordina</a>
        <a class="btn" href={`tel:${site.phoneTel}`}>Chiama</a>
      </div>
    </div>
    <span class="scroll-hint" aria-hidden="true">Scorri</span>
  </div>
</section>
