---
import { Image } from 'astro:assets';
import { site, hours } from '../data/site';
import { imageOf } from '../data/menu';
const photo = imageOf('pulled-prok')!;
// Punti da cui "cola" il succo, in coordinate della foto (viewBox 300×300)
const drips = [
  { cls: 'd1', x: 96, y: 243 },
  { cls: 'd2', x: 138, y: 245 },
  { cls: 'd3', x: 180, y: 244 },
  { cls: 'd4', x: 214, y: 241 },
];
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-pin">
    <div class="hero-photo">
      <Image src={photo} alt="Pulled Pork Grill Burger: pane al sesamo, maiale sfilacciato, formaggio fuso, carne e insalata viola, su fondo nero" widths={[640, 900]} sizes="(min-width:860px) 78vw, 135vw" loading="eager" fetchpriority="high" decoding="async" />
      <div class="sheen" aria-hidden="true"></div>
      <svg viewBox="0 0 300 300" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="juice" cx="40%" cy="35%" r="75%">
            <stop offset="0" stop-color="#9a6a3a" /><stop offset=".55" stop-color="#5b3317" /><stop offset="1" stop-color="#25130a" />
          </radialGradient>
        </defs>
        {drips.map((d) => (
          <>
            <rect class={`neck ${d.cls}`} x={d.x - 1.1} y={d.y - 1} width="2.2" height="9" rx="1.1" fill="#4a2810" />
            <g transform={`translate(${d.x} ${d.y + 6})`}><g class={`drip ${d.cls}`}>
              <path d="M0,-5.5C2,-1.6 3.3,.8 3.3,2.3A3.3,3.3 0 0 1 -3.3,2.3C-3.3,.8 -2,-1.6 0,-5.5Z" fill="url(#juice)" />
              <ellipse cx="-1.1" cy="1.3" rx=".8" ry="1.3" fill="#f3dcb8" opacity=".7" />
            </g></g>
          </>
        ))}
      </svg>
    </div>
    <div class="hero-fade"></div>
    <p class="hero-facts"><span>Roseto degli Abruzzi</span><span>Aperto la sera · {hours.opens}–{hours.closes}</span></p>
    <div class="hero-copy">
      <h1 id="hero-title"><span class="hero-in">Hamburger</span><span class="hero-in l2">e carni <em>alla griglia</em></span></h1>
      <p class="lead hero-in l3">Con ispirazione sudamericana. Ordina dal telefono in un minuto.</p>
      <div class="btn-row hero-in l3">
        <a class="btn primary" href="/menu/">Ordina ora</a>
        <a class="btn" href={`tel:${site.phoneTel}`}>Chiama</a>
      </div>
    </div>
    <span class="scroll-hint" aria-hidden="true">Scorri</span>
  </div>
</section>
