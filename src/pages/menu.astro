---
import Base from '../layouts/Base.astro';
import DishCard from '../components/DishCard.astro';
import { menu } from '../data/menu';
---
<Base title="Menu e ordina" description="Il menu completo di Grill Burger con foto: hamburger di carne, pollo e vegan, braceria, hot dog, insalate, dessert e bevande. Ordina dal telefono e personalizza il tuo piatto." path="/menu/">
  <div class="wrap page-hero">
    <p class="label">Menu</p>
    <h1>Scegli, personalizza, ordina</h1>
    <p class="lead">Tocca un piatto per togliere ingredienti, aggiungere extra e segnalare allergie. Coperto €2. Menu aggiornato al 5 novembre 2026.</p>
  </div>
  <nav class="chips" aria-label="Categorie del menu">
    <ul>{menu.categories.map((c) => <li><a href={`#${c.id}`}>{c.title}</a></li>)}</ul>
  </nav>
  <div class="wrap">
    {menu.categories.map((c, ci) => (
      <section class="menu-cat" id={c.id} aria-labelledby={`h-${c.id}`}>
        <header><h2 id={`h-${c.id}`}>{c.title}</h2></header>
        <div class="grid-dishes">
          {c.items.map((i, n) => <DishCard item={i} eager={ci === 0 && n < 2} />)}
        </div>
      </section>
    ))}
    <p class="note mt-l">Allergeni: segnali nel carrello o consulta <a href="/allergeni/">la pagina dedicata</a>. Prezzi dal menu ufficiale, soggetti a variazioni.</p>
  </div>
</Base>
